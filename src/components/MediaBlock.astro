---
interface Props {
  src: string;
  type?: 'video' | 'gif' | 'image';
  caption?: string;
  autoplay?: boolean;
}
const { src, type = 'image', caption, autoplay = true } = Astro.props;
---

<figure>
  {type === 'video' && (
    <video
      src={src}
      autoplay={autoplay}
      muted
      loop
      playsinline
      controls={!autoplay}
    />
  )}
  {(type === 'gif' || type === 'image') && (
    <img src={src} alt={caption ?? ''} loading="lazy" decoding="async" />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  figure { margin: 0; }
  video, img {
    width: 100%;
    border-radius: 6px;
    border: 1px solid var(--border);
    display: block;
  }
  figcaption {
    font-size: 12px;
    color: var(--muted);
    margin-top: 8px;
    font-family: var(--font-mono);
  }
</style>