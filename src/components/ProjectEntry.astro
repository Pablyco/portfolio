---
interface Props {
  title: string;
  tags?: string[];
  links?: { label: string; href: string }[];
  year?: string;
}
const { title, tags = [], links = [], year } = Astro.props;
---

<article>
  <div class="entry-header">
    <div class="entry-meta">
      <h3>{title}</h3>
      {year && <span class="year">{year}</span>}
    </div>
    <div class="entry-tags">
      {tags.map(t => <span class="tag">{t}</span>)}
    </div>
  </div>

  <!-- Descripción, media, código — todo va acá -->
  <div class="entry-body">
    <slot />
  </div>

  {links.length > 0 && (
    <div class="entry-links">
      {links.map(l => <a href={l.href} target="_blank">{l.label} →</a>)}
    </div>
  )}
</article>
<hr />

<style>
  article { margin-bottom: 32px; }
  .entry-header { margin-bottom: 12px; }
  .entry-meta { display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px; }
  .year { font-size: 12px; color: var(--muted); font-family: var(--font-mono); }
  .entry-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .entry-body { display: flex; flex-direction: column; gap: 16px; margin-top: 12px; }
  .entry-links { display: flex; gap: 20px; font-size: 12px; margin-top: 16px; }
</style>